# ---- pc-agent 配置示例 ----
# 复制成 .env 后按需修改（.env 与 server.mjs 同目录，不会覆盖已有的真实环境变量）

# 监听地址。0.0.0.0 = 允许局域网访问；只想本机测就用 127.0.0.1
PC_AGENT_HOST=0.0.0.0
PC_AGENT_PORT=40000

# 必填。留空时只允许绑定回环地址（否则拒绝启动）。
# 生成方法（PowerShell，兼容 Windows PowerShell 5.1 与 PowerShell 7）：
#   $b = New-Object byte[] 32; ([Security.Cryptography.RandomNumberGenerator]::Create()).GetBytes($b); [Convert]::ToBase64String($b)
PC_AGENT_TOKEN=请替换成一串随机数

# 允许读写的目录，多个用分号分隔。第一个目录是相对路径的基准。
PC_AGENT_ROOTS=D:\work;D:\project

# Host 头白名单（DNS rebinding 防护），不含端口。把 PC 自己的 IP 和主机名写进来。
PC_AGENT_ALLOWED_HOSTS=192.168.1.50,localhost,127.0.0.1,[::1],DESKTOP-XXXX

# 客户端 IP 白名单（可选但强烈建议）。只填运行 AI 宿主那台机器的 IP。
PC_AGENT_ALLOWED_IPS=192.168.1.10

# 可选：单次工具返回的输出上限（字节）与命令默认超时（秒）
# PC_AGENT_MAX_OUTPUT=200000
# PC_AGENT_CMD_TIMEOUT=120
